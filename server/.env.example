# Copy to server/.env

# Required. MongoDB connection string, e.g. MongoDB Atlas:
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/worqube?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/worqube

# Required. Long random string that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production the server refuses to start with a short or placeholder secret.
JWT_SECRET=change-me

# Optional
# PORT=5000
# NODE_ENV=production
# TRUST_PROXY=1   # set on hosts behind a load balancer (Render, Railway, Heroku)
